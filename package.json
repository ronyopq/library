{
  "name": "personal-library-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "wrangler dev --local --port 8787",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply library-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply library-db --remote",
    "db:seed:local": "wrangler d1 execute library-db --local --file drizzle/0001_seed.sql",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.39.1",
    "hono": "^4.6.20",
    "lucide-react": "^0.474.0",
    "papaparse": "^5.5.2",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-barcode": "^1.5.3",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.4.2",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.30.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@hookform/resolvers": "^3.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.30.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "wrangler": "^4.0.0"
  }
}
